@using Microsoft.AspNetCore.Components
@using MudBlazor
@using StelexarasApp.Application.ApiClients

@inherits LayoutComponentBase

@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IPaidiaApi PaidiaApi
@inject NavigationManager NavigationManager

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <main>
        <div class="top-row px-4"
             style=" height:10vh; display:flex; align-items:center; justify-content:space-between; background: linear-gradient(90deg, #e9eef1 0%, #f3f6f8 55%, #f3cccc  100%);">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Default"
                           OnClick="GoBack" />
            <MudButton Href="/">
                <MudText Typo="Typo.h5" Style="color:darkred;">Κατασκηνώσεις ΤΥΠΕΤ</MudText>
            </MudButton>
            <div style="gap:12px; align-items:center; width:80vh">
                <MudAutocomplete T="string"
                                 Clearable="true"
                                 Label="Αναζήτηση παιδιών:"
                                 Variant="Variant.Outlined"
                                 ShowProgressIndicator="true"
                                 Value="_selectedPaidiName" 
                                 SearchFunc="SearchGenerally"
                                 ValueChanged="OnPaidiSelected"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 CoerceValue="true"
                                 Dense="true" />
            </div>
            <div style="display:flex; gap:12px; align-items:center;">
                <MudMenu Label="Προσθήκη" StartIcon="@Icons.Material.Filled.Add">
                    <MudMenuItem StartIcon="@Icons.Material.Filled.ChildCare" OnClick="AddPaidi">Προσθήκη παιδιού</MudMenuItem>
                    <MudMenuItem StartIcon="@Icons.Material.Filled.ChildCare" OnClick="AddStelexos">Προσθήκη στελέχους</MudMenuItem>
                    <MudMenuItem StartIcon="@Icons.Material.Filled.ChildCare" OnClick="AddPlace">Προσθήκη χώρου</MudMenuItem>
                </MudMenu>
            </div>
        </div>
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? _selectedPaidiName;

    private async Task<IEnumerable<string>> SearchGenerally(string? value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Enumerable.Empty<string>();
        }

        var paidia = await PaidiaApi.SearchPaidiaByName(value, new());

        return paidia.Select(p => $"{p.FirstName} {p.LastName}");
    }

    private async Task OnPaidiSelected(string selectedName)
    {
        if (string.IsNullOrWhiteSpace(selectedName))
            return;

        _selectedPaidiName = selectedName;

        var paidia = await PaidiaApi.SearchPaidiaByName(selectedName, new());
        var paidi = paidia.FirstOrDefault(p => $"{p.FirstName} {p.LastName}" == selectedName);

        if (paidi == null)
            return;

        var parameters = new DialogParameters<EditPaidiDialog>
        {
            { x => x.Paidi, paidi }
        };

        await DialogService.ShowAsync<EditPaidiDialog>("Επεξεργασία Παιδιού", parameters);        
    }

    private async Task AddPaidi()
    {
        var dialog = await DialogService.ShowAsync<AddPaidiDialog>("Προσθήκη Παιδιού");
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task AddStelexos()
    {
        var dialog = await DialogService.ShowAsync<AddStelexosDialog>("Προσθήκη Στελέχους");
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task AddPlace()
    {
        var dialog = await DialogService.ShowAsync<AddXwroDialog>("Προσθήκη Χώρου");
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            NavigationManager.NavigateTo("/");
        }
    }    
    
    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
}