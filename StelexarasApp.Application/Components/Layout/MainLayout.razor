@using MudBlazor
@inherits LayoutComponentBase

@inject IDialogService DialogService

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <main>
        <div class="top-row px-4"
             style=" height:10vh; display:flex; align-items:center; justify-content:space-between; background: linear-gradient(90deg, #e9eef1 0%, #f3f6f8 55%, #cfeee6 100%);">
            <MudButton Href="/">
                <MudText Typo="Typo.h5">Κατασκηνώσεις ΤΥΠΕΤ</MudText>
            </MudButton>
            <div style="gap:12px; align-items:center; width:80vh">
                <MudAutocomplete T="string" Label="Search..." Variant="Variant.Outlined" ShowProgressIndicator="true" />
            </div>
            <div style="display:flex; gap:12px; align-items:center;">
                <MudButton Href="/help" Variant="Variant.Text">Βοήθεια</MudButton>
                <MudMenu Label="Προσθήκη" StartIcon="@Icons.Material.Filled.Add">
                    <MudMenuItem StartIcon="@Icons.Material.Filled.ChildCare" OnClick="AddPaidi">Προσθήκη παιδιού</MudMenuItem>
                    <MudMenuItem StartIcon="@Icons.Material.Filled.ChildCare" OnClick="AddStelexos">Προσθήκη στελέχους</MudMenuItem>
                    <MudMenuItem StartIcon="@Icons.Material.Filled.ChildCare" OnClick="AddPlace">Προσθήκη χώρου</MudMenuItem>
                </MudMenu>
            </div>
        </div>
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task AddPaidi()
    {
        await DialogService.ShowAsync<AddPaidiDialog>("Προσθήκη Παιδιού");
    }

    private async Task AddStelexos()
    {
        await DialogService.ShowAsync<AddStelexosDialog>("Προσθήκη Στελέχους");
    }

    private async Task AddPlace()
    {
        await DialogService.ShowAsync<AddXwroDialog>("Προσθήκη Χώρου");
    }
}