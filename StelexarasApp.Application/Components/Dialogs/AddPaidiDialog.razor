@using System.ComponentModel.DataAnnotations
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.People.Children
@using StelexarasApp.Library.Models.Atoma
@using StelexarasApp.Library.Models.Atoma.Children

@inherits ComponentBase

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IPaidiaApi PaidiaApi
@inject IXwroiApi XwroiApi

<MudDialog MaxWidth="MaxWidth.Large" Style="width:400px" FullWidth="true">
    <DialogContent>
        <MudForm Spacing="2">
            <MudTextField @bind-Value="req.FirstName" Label="Όνομα" />
            <MudTextField @bind-Value="req.LastName" Label="Επίθετο" />
            <MudSwitch @bind-Value="IsEkpaideuomenos" Label="Εκπαιδευόμενος" />
            <MudNumericField @bind-Value="req.Age"
                             Label="Ηλικία"
                             Disabled="@(IsEkpaideuomenos)" />
            <MudSelect T="Sex" @bind-Value="req.Sex" Label="Φύλο">
                @foreach (var sex in Enum.GetValues<Sex>())
                {
                    <MudSelectItem T="Sex" Value="sex">
                        @GetDisplayName(sex)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudAutocomplete T="string"
                             Label="Χώρος"
                             @bind-Value="req.SkiniName"
                             SearchFunc="SearchXwroi"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="true"
                             CoerceValue="true"
                             Dense="true" />
            <MudSwitch @bind-Value="req.SeAdeia" Label="Σε Αδεία;" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Αποθήκευση</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private CreatePaidiRequest req = new();
    private List<string> _xwroiNames = new();

    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    protected async override void OnParametersSet()
    {
        var skines = await XwroiApi.GetSkinesAsync(new());
        _xwroiNames = skines.Select(x => x.Name)
                            .Distinct()
                            .OrderBy(x => x)
                            .ToList();
    }

    private void Cancel(MouseEventArgs args)
    {
        Dialog.Cancel();
    }

    private async Task Save(MouseEventArgs _)
    {
        if (req.PaidiType == PaidiType.Ekpaideuomenos)
        {
            req.Age = 16;
        }
        else if (req.Age < 0 || req.Age > 18)
        {
            Snackbar.Add("Η ηλικία πρέπει να είναι μεταξύ 0 και 18.", Severity.Error);
            return;
        }

        var newPaidiRequest = new CreatePaidiRequest
        {
            FirstName = req.FirstName,
            LastName = req.LastName,
            Age = req.Age,
            Sex = req.Sex,
            PaidiType = req.PaidiType,
            SeAdeia = req.SeAdeia,
            SkiniName = req.SkiniName,
            ParentPhone = req.ParentPhone
        };

        if (IsSomethingMissing(newPaidiRequest))
        {
            Snackbar.Add("Σφάλμα κατά την αποθήκευση του παιδιού, παρακαλώ συμπληρώστε όλα τα πεδία.", Severity.Error);
        }

        var result = await PaidiaApi.PostPaidi(newPaidiRequest);
        if (result == false)
        {
            Snackbar.Add("Σφάλμα κατά την αποθήκευση του παιδιού.", Severity.Error);
            return;
        }
        else
        {
            Snackbar.Add("Το παιδι αποθηκεύτηκε επιτυχώς.", Severity.Success);
            Dialog?.Close(DialogResult.Ok(newPaidiRequest));
        }
    }

    private Task<IEnumerable<string>> SearchXwroi(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Task.FromResult(_xwroiNames.AsEnumerable());
        }

        var xwroi = _xwroiNames.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return Task.FromResult(xwroi);
    }

    private bool IsEkpaideuomenos
    {
        get => req.PaidiType == PaidiType.Ekpaideuomenos;
        set
        {
            req.PaidiType = value ? PaidiType.Ekpaideuomenos : PaidiType.Kataskinotis;
            if (value)
                req.Age = 16;
            else if (req.Age == 16)
                req.Age = 12; // for example 12, you can set it to any default value you want when switching back to Kataskinotis
        }
    }

    private string GetDisplayName(Enum sex)
    {
        var member = sex.GetType().GetMember(sex.ToString()).First();
        var displayAttribute = member.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
        return displayAttribute?.Name ?? sex.ToString();
    }

    private bool IsSomethingMissing(CreatePaidiRequest newPaidiRequest)
    {
        return string.IsNullOrWhiteSpace(newPaidiRequest.FirstName) ||
               string.IsNullOrWhiteSpace(newPaidiRequest.LastName) ||
               newPaidiRequest.Age <= 0 ||
               newPaidiRequest.Sex == default ||
               string.IsNullOrWhiteSpace(newPaidiRequest.ParentPhone);
    }
}