@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.People.Staff

@inherits ComponentBase

@inject ISnackbar Snackbar
@inject IStelexiApi StelexiApi
@inject IXwroiApi XwroiApi
@inject IDialogService DialogService
@inject NavigationManager Navigation

<MudDialog MaxWidth="MaxWidth.Large" Style="width:400px" FullWidth="true">
    <DialogContent>
        <MudForm Spacing="2">
            <MudTextField @bind-Value="PersonToEdit.FirstName" Label="Όνομα" />
            <MudTextField @bind-Value="PersonToEdit.LastName" Label="Επώνυμο" />
            <MudAutocomplete T="string"
                             Label="Χώρος"
                             @bind-Value="PersonToEdit.XwrosName"
                             SearchFunc="SearchXwroi"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="true"
                             CoerceValue="true"
                             Dense="true" />
            <MudNumericField @bind-Value="PersonToEdit.Tel" Label="Τηλέφωνο" />
            <MudSwitch @bind-Value="PersonToEdit.SeAdeia" Label="Σε άδεια" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="Delete">ΔΙΑΓΡΑΦΗ</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Αποθήκευση</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private StelexosResponse PersonToEdit = new();
    private List<string> _xwroiNames = new();

    [Parameter] public StelexosResponse Stelexos { get; set; } = default!;
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        PersonToEdit = new StelexosResponse()
        {
            Age = Stelexos.Age,
            FirstName = Stelexos.FirstName,
            LastName = Stelexos.LastName,
            Tel = Stelexos.Tel,
            XwrosName = Stelexos.XwrosName
        };

        var skines = await XwroiApi.GetSkinesAsync(new());
        _xwroiNames = skines.Select(x => x.Name)
                            .Distinct()
                            .OrderBy(x => x)
                            .ToList();
    }

    private void Cancel(MouseEventArgs args)
    {
        Dialog.Cancel(); 
    }

    private async Task Save(MouseEventArgs _)
    {
        var personToUpdateRequest = new UpdateStelexosRequest()
        {
            LastName = PersonToEdit.LastName,
            FirstName = PersonToEdit.FirstName,
            Age = PersonToEdit.Age,
            XwrosName = PersonToEdit.XwrosName,
            Sex = Stelexos.Sex,
            Thesi = Stelexos.Thesi,
            SeAdeia = Stelexos.SeAdeia,
            Tel = PersonToEdit.Tel
        };

        var result = await StelexiApi.UpdateStelexos(Stelexos.Id, personToUpdateRequest);
        if (result != false)
        {
            Snackbar.Add("Το στελέχος ενημερώθηκε επιτυχώς!", Severity.Success);
            Dialog?.Close(DialogResult.Ok(result));
        }
        else
        {
            Snackbar.Add("Αποτυχία ενημέρωσης του στελέχους.", Severity.Error);
        }
    }

    private Task<IEnumerable<string>> SearchXwroi(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Task.FromResult(_xwroiNames.AsEnumerable());
        }

        var xwroi = _xwroiNames.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return Task.FromResult(xwroi);
    }

    private async Task Delete()
    {
        string confirmationMessage = "Είστε σίγουροι ότι θέλετε να διαγράψετε το στέλεχος; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί.";
        bool? confirmed = await DialogService.ShowMessageBox("Επιβεβαίωση Διαγραφής", confirmationMessage, yesText: "Ναι", noText: "Όχι");

        if (confirmed != true)
            return;

        var result = await StelexiApi.DeleteStelexos(Stelexos.Id);

        if (result)
        {
            Snackbar.Add("Το στέλεχος διαγράφηκε επιτυχώς.", Severity.Success);
            Dialog?.Close(DialogResult.Ok("delete"));
        }
        else
        {
            Snackbar.Add("Σφάλμα κατά τη διαγραφή του στελέχους.", Severity.Error);
        }
    }
}
