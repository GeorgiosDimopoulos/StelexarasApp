    private Task<IEnumerable<string>> SearchXwroi(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Task.FromResult(_xwroiNames.AsEnumerable());
        }

        var xwroi = _xwroiNames.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return Task.FromResult(xwroi);
    }
}
