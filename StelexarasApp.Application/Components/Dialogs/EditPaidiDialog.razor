@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.People.Children

@inherits ComponentBase

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IPaidiaApi PaidiaApi
@inject IXwroiApi XwroiApi
@inject IDialogService DialogService

<MudDialog MaxWidth="MaxWidth.Large" Style="width:400px" FullWidth="true">
    <DialogContent>
        <MudForm Spacing="2">
            <MudTextField @bind-Value="PaidiToEdit.FirstName" Label="Όνομα" />
            <MudTextField @bind-Value="PaidiToEdit.LastName" Label="Επώνυμο" />
            <MudNumericField @bind-Value="PaidiToEdit.Age" Label="Ηλικία" />
            <MudNumericField @bind-Value="PaidiToEdit.ParentTel" Label="Τηλέφωνο" />
            <MudAutocomplete T="string"
                             Label="Χώρος"
                             @bind-Value="PaidiToEdit.SkiniName"
                             SearchFunc="SearchXwroi"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             CoerceText="true"
                             CoerceValue="true"
                             Dense="true" />
            <MudText Typo="Typo.h6">ΦΥΛΟ: @PaidiToEdit.Sex</MudText>
            <MudSwitch @bind-Value="PaidiToEdit.SeAdeia" Label="Σε αδεια;" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="Delete">ΔΙΑΓΡΑΦΗ</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Αποθήκευση</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private PaidiResponse PaidiToEdit = new();
    private List<string> _xwroiNames = new();

    [Parameter] public PaidiResponse Paidi { get; set; } = default!;
    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        PaidiToEdit = new PaidiResponse()
        {
            Age = Paidi.Age,
            FirstName = Paidi.FirstName,
            SeAdeia = Paidi.SeAdeia,
            SkiniName = Paidi.SkiniName,
            LastName = Paidi.LastName,
            Id = Paidi.Id,
            Sex = Paidi.Sex,
            PaidiType = Paidi.PaidiType,
            ParentTel = Paidi.ParentTel
        };

        var skines = await XwroiApi.GetSkinesAsync(new());
        _xwroiNames = skines.Select(x => x.Name)
                            .Distinct()
                            .OrderBy(x => x)
                            .ToList();
    }

    private void Cancel(MouseEventArgs args)
    {
        Dialog.Cancel();
    }

    private async Task Delete()
    {
        string confirmationMessage = "Είστε σίγουροι ότι θέλετε να διαγράψετε το παιδί; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί.";
        bool? confirmed = await DialogService.ShowMessageBox("Επιβεβαίωση Διαγραφής", confirmationMessage, yesText: "Ναι", noText: "Όχι");

        if (confirmed != true)
            return;

        var result = await PaidiaApi.DeletePaidi(Paidi.Id);

        if (result)
        {
            Snackbar.Add("Το παιδί διαγράφηκε επιτυχώς.", Severity.Success);
            Dialog?.Close(DialogResult.Ok("delete"));
            Navigation.NavigateTo("/xwroi");
        }
        else
        {
            Snackbar.Add("Σφάλμα κατά τη διαγραφή του παιδιού.", Severity.Error);
        }
    }

    private async Task Save(MouseEventArgs _)
    {
        var paidiUpdateRequest = new UpdatePaidiRequest()
        {
            LastName = PaidiToEdit.LastName,
            FirstName = PaidiToEdit.FirstName,
            Age = PaidiToEdit.Age,
            ParentTel = PaidiToEdit.ParentTel,
            SeAdeia = PaidiToEdit.SeAdeia,
            SkiniName = PaidiToEdit.SkiniName,
            Sex = PaidiToEdit.Sex,
            PaidiType = PaidiToEdit.PaidiType
        };

        var result = await PaidiaApi.UpdatePaidi(Paidi.Id, paidiUpdateRequest);
        if (result != false)
        {
            Snackbar.Add("Το παιδί ενημερώθηκε επιτυχώς!", Severity.Success);
            Dialog?.Close(DialogResult.Ok(result));
        }
        else
        {
            Snackbar.Add("Αποτυχία ενημέρωσης του παιδιού.", Severity.Error);
        }
    }

