@using System.ComponentModel.DataAnnotations
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi
@using StelexarasApp.Library.Dtos.People.Staff
@using StelexarasApp.Library.Models.Atoma
@using StelexarasApp.Library.Models.Atoma.Staff

@inherits ComponentBase

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStelexiApi StelexiApi
@inject IXwroiApi XwroiApi

<MudDialog MaxWidth="MaxWidth.Large" Style="width:400px" FullWidth="true">
    <DialogContent>
        <MudForm Spacing="2">
            <MudTextField @bind-Value="req.FirstName" Label="Όνομα" />
            <MudTextField @bind-Value="req.LastName" Label="Επίθετο" />
            <MudNumericField @bind-Value="req.Age" Label="Ηλικία" />
            <MudTextField @bind-Value="req.Tel" Label="Τηλέφωνο" />
            <MudSelect T="Thesi" Value="req.Thesi" Label="Θέση" ValueChanged="OnThesiChanged">
                @foreach (var thesi in Enum.GetValues<Thesi>())
                {
                    <MudSelectItem T="Thesi" Value="thesi">
                        @GetDisplayName(thesi)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Sex" @bind-Value="req.Sex" Label="Φύλο">
                @foreach (var sex in Enum.GetValues<Sex>())
                {
                    <MudSelectItem T="Sex" Value="sex">
                        @GetDisplayName(sex)
                    </MudSelectItem>
                }
            </MudSelect>
            @if (req.Thesi != Thesi.Ekpaideutis)
            {
                <MudAutocomplete T="string"
                                 Label="Χώρος"
                                 MaxItems="null"
                                 @bind-Value="req.XwrosName"
                                 SearchFunc="SearchXwroi"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 CoerceValue="true"
                                 Dense="true" />
            }
            <MudSwitch T="bool" @bind-Value="req.SeAdeia" Label="Σε άδεια" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Αποθήκευση</MudButton>
    </DialogActions>
</MudDialog>


@code {
    private CreateStelexosRequest req = new();
    private List<string> _xwroiNames = new();
    private List<SkiniResponse> _skines = [];
    private List<KoinotitaResponse> _koinotites = [];
    private List<TomeasResponse> _tomeis = [];
    private List<string> _anwtatoiXwroi = [];

    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    protected async override void OnParametersSet()
    {
        await Task.Delay(200);

        _skines = await XwroiApi.GetSkinesAsync(new());
        _koinotites = await XwroiApi.GetKoinotitesAsync(new());
        _tomeis = await XwroiApi.GetTomeisAsync(new());
        _anwtatoiXwroi = await XwroiApi.GetAnwtatoiXwroiAsync();

        _xwroiNames = _skines.Select(x => x.Name)
                            .Concat(_koinotites.Select(x => x.Name))
                            .Concat(_tomeis.Select(x => x.Name))
                            .Concat(_anwtatoiXwroi)
                            .Distinct()
                            .OrderBy(x => x)
                            .ToList();
    }

    private void Cancel(MouseEventArgs args)
    {
        Dialog?.Close(DialogResult.Cancel());
    }

    private async Task Save(MouseEventArgs _)
    {
        var newStelexosRequest = new CreateStelexosRequest
        {
            FirstName = req.FirstName,
            LastName = req.LastName,
            Age = req.Age,
            Sex = req.Sex,
            Tel = req.Tel,
            Thesi = req.Thesi,
            XwrosName = req.Thesi == Thesi.Ekpaideutis ? "Ήπειρος - Σχολή" : req.XwrosName,
        };

        if (IsSomethingMissing(newStelexosRequest))
        {
            Snackbar.Add("Σφάλμα κατά την αποθήκευση του στελέχους, παρακαλώ συμπληρώστε όλα τα πεδία.", Severity.Error);
            return;
        }

        var result = await StelexiApi.PostStelexos(newStelexosRequest);
        if (result == false)
        {
            Snackbar.Add("Σφάλμα κατά την αποθήκευση του στελέχους.", Severity.Error);
            return;
        }
        else
        {
            Snackbar.Add("Το στέλεχος αποθηκεύτηκε επιτυχώς.", Severity.Success);
            Dialog?.Close(DialogResult.Ok(newStelexosRequest));
            Navigation.NavigateTo("/xwroi");
        }
    }

    private string GetDisplayName(Enum sex)
    {
        var member = sex.GetType().GetMember(sex.ToString()).First();
        var displayAttribute = member.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
        return displayAttribute?.Name ?? sex.ToString();
    }

    private Task<IEnumerable<string>> SearchXwroi(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
        {
            return Task.FromResult(_xwroiNames.AsEnumerable());
        }

        var xwroi = _xwroiNames.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase));
        return Task.FromResult(xwroi);
    }

    private bool IsSomethingMissing(CreateStelexosRequest request)
    {
        return string.IsNullOrWhiteSpace(request.FirstName) ||
               string.IsNullOrWhiteSpace(request.LastName) ||
               request.Age <= 0 ||
               (request.Sex != Sex.Female && request.Sex != Sex.Male) ||
               string.IsNullOrWhiteSpace(request.XwrosName) ||
               string.IsNullOrWhiteSpace(request.Tel) ||
               (request.Thesi != Thesi.Anwtatos && request.Thesi != Thesi.Omadarxis && request.Thesi != Thesi.Koinotarxis && request.Thesi != Thesi.Tomearxis && request.Thesi != Thesi.Ekpaideutis && request.Thesi != Thesi.Eidiko);
    }

    private async Task OnThesiChanged(Thesi thesi)
    {
        req.Thesi = thesi;
        req.XwrosName = string.Empty;

        if (thesi == Thesi.Anwtatos)
        {
            var anwtatoiXwroi = await XwroiApi.GetAnwtatoiXwroiAsync();
            _xwroiNames = anwtatoiXwroi.Distinct().OrderBy(x => x).ToList();
        }
        else if (thesi == Thesi.Koinotarxis)
        {
            var koinotites = await XwroiApi.GetKoinotitesAsync(new());
            _xwroiNames = koinotites.Select(x => x.Name)
                                .Distinct()
                                .OrderBy(x => x)
                                .ToList();
        }
        else if (thesi == Thesi.Omadarxis)
        {
            var skines = (await XwroiApi.GetSkinesAsync(new())).Where(sk => sk.OmadarxisId == 0);
            _xwroiNames = skines.Select(x => x.Name)
                                .Distinct()
                                .OrderBy(x => x)
                                .ToList();
        }
        else if (thesi == Thesi.Tomearxis)
        {
            var tomeis = await XwroiApi.GetTomeisAsync(new());
            _xwroiNames = tomeis.Select(x => x.Name)
                                .Distinct()
                                .OrderBy(x => x)
                                .ToList();
        }
        else
        {
            _xwroiNames = new List<string>();
        }
    }
}