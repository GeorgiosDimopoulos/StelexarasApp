@using System.ComponentModel.DataAnnotations
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.People.Staff
@using StelexarasApp.Library.Models.Atoma
@using StelexarasApp.Library.Models.Atoma.Staff

@inherits ComponentBase

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStelexiApi StelexiApi

<MudDialog MaxWidth="MaxWidth.Large" Style="width:400px" FullWidth="true">
    <DialogContent>
        <MudForm Spacing="2">
            <MudTextField @bind-Value="req.FirstName" Label="Όνομα" />
            <MudTextField @bind-Value="req.LastName" Label="Επίθετο" />
            <MudNumericField @bind-Value="req.Age" Label="Ηλικία" />
            <MudTextField @bind-Value="req.Tel" Label="Τηλέφωνο" />
            <MudSelect T="Thesi" @bind-Value="req.Thesi" Label="Θέση">
                @foreach (var thesi in Enum.GetValues<Thesi>())
                {
                    <MudSelectItem T="Thesi" Value="thesi">
                        @GetDisplayName(thesi)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Sex" @bind-Value="req.Sex" Label="Φύλο">
                @foreach (var sex in Enum.GetValues<Sex>())
                {
                    <MudSelectItem T="Sex" Value="sex">
                        @GetDisplayName(sex)
                    </MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="req.XwrosName" Label="Χώρος" />
             <MudSwitch @bind-Value="req.Thesi" Label="Σε άδεια" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Αποθήκευση</MudButton>
    </DialogActions>
</MudDialog>


@code {
    private CreateStelexosRequest req = new();

    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    protected async override void OnParametersSet()
    {
        await Task.Delay(500);
    }

    private void Cancel(MouseEventArgs args)
    {
        Dialog?.Close(DialogResult.Ok(req));
    }

    private async Task Save(MouseEventArgs _)
    {
        var newStelexosRequest = new CreateStelexosRequest
        {
            FirstName = req.FirstName,
            LastName = req.LastName,
            Age = req.Age,
            Sex = req.Sex,
            Tel = req.Tel,
            XwrosName = req.XwrosName,
            Thesi = req.Thesi
        };

        var result = await StelexiApi.PostStelexos(newStelexosRequest);
        if (result == null)
        {
            Snackbar.Add("Σφάλμα κατά την αποθήκευση του στελέχους.", Severity.Error);
            return;
        }
        else
        {
            Snackbar.Add("Το στέλεχος αποθηκεύτηκε επιτυχώς.", Severity.Success);
            Dialog?.Close(DialogResult.Ok(newStelexosRequest));
        }
    }

    private string GetDisplayName(Enum sex)
    {
        var member = sex.GetType().GetMember(sex.ToString()).First();
        var displayAttribute = member.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
        return displayAttribute?.Name ?? sex.ToString();
    }
}
