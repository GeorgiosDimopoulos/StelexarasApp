@using System.ComponentModel.DataAnnotations
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi

@inherits ComponentBase

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IKoinotitesApi KoinotitesApi
@inject ITomeisApi TomeisApi
@inject ISkinesApi SkinesApi

<MudDialog MaxWidth="MaxWidth.Large" Style="width:400px" FullWidth="true">
    <DialogContent>
        <MudForm Spacing="2">
            <MudTextField @bind-Value="req.Name" Label="Όνομα" />
            <MudSelect T="XwrosType" @bind-Value="req.XwrosType" Label="Είδος Χώρου">
                @foreach (var xwrosType in Enum.GetValues<XwrosType>())
                {
                    <MudSelectItem T="XwrosType" Value="xwrosType">@xwrosType</MudSelectItem>
                }
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Αποθήκευση</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private AddXwrosModel req = new();

    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    protected async override void OnParametersSet()
    {
        await Task.Delay(500);
    }

    private void Cancel(MouseEventArgs args)
    {
        Dialog?.Close(DialogResult.Ok(req));
    }

    private async Task Save(MouseEventArgs _)
    {
        switch (req.XwrosType)
        {
            case XwrosType.Skini:
                var skini = new CreateSkiniRequest
                {
                    Name = req.Name,
                    KoinotitaId = req.KoinotitaId ?? 0,
                    // Sex = Sex.Male
                };

                var result = await SkinesApi.PostSkini(skini);
                if (result == null)
                {
                    Snackbar.Add("Σφάλμα κατά την αποθήκευση της σκηνής.", Severity.Error);
                    return;
                }
                else
                {
                    Snackbar.Add("Η σκηνή αποθηκεύτηκε επιτυχώς.", Severity.Success);

                    Dialog?.Close(DialogResult.Ok(result));
                }

                Dialog?.Close(DialogResult.Ok(skini));
                break;
            case XwrosType.Koinotita:
                var koinotita = new CreateKoinotitaRequest
                {
                    Name = req.Name,
                    TomeasName = req.Tomeasname ?? string.Empty
                };

                var kresult = await KoinotitesApi.PostKoinotita(koinotita);
                if (kresult == false)
                {
                    Snackbar.Add("Σφάλμα κατά την αποθήκευση της κοινότητας.", Severity.Error);
                    return;
                }
                else
                {
                    Snackbar.Add("Η κοινότητα αποθηκεύτηκε επιτυχώς.", Severity.Success);

                    Dialog?.Close(DialogResult.Ok(kresult));
                }

                Dialog?.Close(DialogResult.Ok(koinotita));
                break;
            case XwrosType.Tomeas:
                var tomeas = new CreateTomeasRequest
                {
                    Name = req.Name

                };

                var tresult = await TomeisApi.PostTomea(tomeas);
                if (tresult == null)
                {
                    Snackbar.Add("Σφάλμα κατά την αποθήκευση του τομέα.", Severity.Error);
                    return;
                }
                else
                {
                    Snackbar.Add("Ο τομέας αποθηκεύτηκε επιτυχώς.", Severity.Success);

                    Dialog?.Close(DialogResult.Ok(tresult));
                }

                Dialog?.Close(DialogResult.Ok(tresult));
                break;
        }
    }

    public class AddXwrosModel
    {
        public string Name { get; set; } = string.Empty;
        public XwrosType XwrosType { get; set; }

        public string? Tomeasname { get; set; }
        public int? KoinotitaId { get; set; }
    }

    public enum XwrosType
    {
        [Display(Name = "Σκηνή")]
        Skini,

        [Display(Name = "Κοινότητα")]
        Koinotita,

        [Display(Name = "Τομέας")]
        Tomeas
    }
}