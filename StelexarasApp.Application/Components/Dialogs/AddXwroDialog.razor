@using System.ComponentModel.DataAnnotations
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi
@using StelexarasApp.Library.Models.Atoma
@using StelexarasApp.Library.QueryParameters.Domi

@inherits ComponentBase

@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IKoinotitesApi KoinotitesApi
@inject ITomeisApi TomeisApi
@inject ISkinesApi SkinesApi

<MudDialog MaxWidth="MaxWidth.Large" Style="width:400px" FullWidth="true">
    <DialogContent>
        <MudForm Spacing="2">
            <MudTextField @bind-Value="model.Name" Label="Όνομα" />
            <MudSelect T="XwrosType" @bind-Value="model.XwrosType" Label="Είδος Χώρου">
                @foreach (var xwrosType in Enum.GetValues<XwrosType>())
                {
                    <MudSelectItem T="XwrosType" Value="xwrosType">
                        @GetDisplayName(xwrosType)
                    </MudSelectItem>
                }
            </MudSelect>
            @if (model.XwrosType == XwrosType.Skini)
            {
                <MudSelect T="int?" Label="Κοινότητα" @bind-Value="model.KoinotitaId">
                    @foreach (var koinotita in koinotites.OrderBy(k => k.Name))
                    {
                        <MudSelectItem T="int?" Value="@((int?)koinotita.Id)">
                            @koinotita.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            }

            @if (model.XwrosType == XwrosType.Koinotita)
            {
                <MudSelect T="string" Label="Τομέας" @bind-Value="model.Tomeasname">
                    @foreach (var tomeas in tomeis.OrderBy(k => k.Name))
                    {
                        <MudSelectItem T="string" Value="@(tomeas.Name)">
                            @tomeas.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant=" Variant.Text" OnClick="Cancel">Ακύρωση</MudButton>
        <MudButton Color="Color.Primary" Variant=" Variant.Filled" OnClick="Save">Αποθήκευση</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private AddXwrosModel model = new();
    private List<KoinotitaResponse> koinotites = new();
    private List<TomeasResponse> tomeis = new();

    [CascadingParameter] IMudDialogInstance Dialog { get; set; } = default!;

    protected async override void OnParametersSet()
    {
        await Task.Delay(500);

        koinotites = await KoinotitesApi.GetKoinotitesAsync(new KoinotitaQueryParameters());
        tomeis = await TomeisApi.GetTomeisAsync(new());
    }

    private void Cancel(MouseEventArgs args)
    {
        Dialog?.Cancel();
    }

    private async Task Save(MouseEventArgs _)
    {
        switch (model.XwrosType)
        {
            case XwrosType.Skini:
                var skini = new CreateSkiniRequest
                {
                    Name = model.Name,
                    KoinotitaId = model.KoinotitaId ?? 0,
                    Sex = model.Sex
                };

                var result = await SkinesApi.PostSkini(skini);
                if (result == false)
                {
                    Snackbar.Add("Σφάλμα κατά την αποθήκευση της σκηνής.", Severity.Error);
                    return;
                }
                else
                {
                    Snackbar.Add("Η σκηνή αποθηκεύτηκε επιτυχώς.", Severity.Success);
                    Dialog?.Close(DialogResult.Ok(result));
                }

                Dialog?.Close(DialogResult.Ok(skini));
                break;
            case XwrosType.Koinotita:
                var koinotita = new CreateKoinotitaRequest
                {
                    Name = model.Name,
                    TomeasName = model.Tomeasname ?? string.Empty
                };

                var kresult = await KoinotitesApi.PostKoinotita(koinotita);
                if (kresult == false)
                {
                    Snackbar.Add("Σφάλμα κατά την αποθήκευση της κοινότητας.", Severity.Error);
                    return;
                }
                else
                {
                    Snackbar.Add("Η κοινότητα αποθηκεύτηκε επιτυχώς.", Severity.Success);

                    Dialog?.Close(DialogResult.Ok(kresult));
                }

                Dialog?.Close(DialogResult.Ok(koinotita));
                break;
            case XwrosType.Tomeas:
                var tomeas = new CreateTomeasRequest
                {
                    Name = model.Name

                };

                var tresult = await TomeisApi.PostTomea(tomeas);
                if (tresult == null)
                {
                    Snackbar.Add("Σφάλμα κατά την αποθήκευση του τομέα.", Severity.Error);
                    return;
                }
                else
                {
                    Snackbar.Add("Ο τομέας αποθηκεύτηκε επιτυχώς.", Severity.Success);

                    Dialog?.Close(DialogResult.Ok(tresult));
                }

                Dialog?.Close(DialogResult.Ok(tresult));
                break;
        }
    }

    public class AddXwrosModel
    {
        public string Name { get; set; } = string.Empty;
        public XwrosType XwrosType { get; set; }
        public Sex Sex { get; set; }
        public string? Tomeasname { get; set; }
        public int? KoinotitaId { get; set; }
    }

    public enum XwrosType
    {
        [Display(Name = "Σκηνή")]
        Skini,

        [Display(Name = "Κοινότητα")]
        Koinotita,

        [Display(Name = "Τομέας")]
        Tomeas
    }

    private string GetDisplayName(Enum type)
    {
        var member = type.GetType().GetMember(type.ToString()).First();
        var displayAttribute = member.GetCustomAttributes(typeof(DisplayAttribute), false).FirstOrDefault() as DisplayAttribute;
        return displayAttribute?.Name ?? type.ToString();
    }
}