@page "/koinotites/{KoinotitaId:int}"
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi

@inject ISkinesApi SkinesApi
@inject IKoinotitesApi KoinotitesApi
@inject IDialogService DialogService

<h1 style="text-align:center; padding-block-start:5px; margin-bottom:4px">ΣΚΗΝΕΣ</h1>
<h1 style="text-align:center">@KoinotitaName</h1>

<MudGrid Justify="Justify.Center" Style="height:calc(100vh - 10vh);  align-items:center;">
    <MudItem xs="12" sm="4">
        <MudStack Justify="Justify.Center"
                  AlignItems="AlignItems.Center"
                  Spacing="10">
            @foreach (var sk in Skines)
            {
                <MudButton Href="@($"/skines/{sk.Id}")" Style="height:100px; padding:30px;width:500px; border-radius:16px; overflow:hidden; color:white; background-color:yellowgreen">
                    @sk.Name
                </MudButton>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public int KoinotitaId { get; set; }
    public string KoinotitaName { get; set; } = string.Empty;

    private List<SkiniResponse> Skines { get; set; } = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Skines = await SkinesApi.GetSkinesByKoinotitaIdAsync(KoinotitaId);
            KoinotitaName = (await KoinotitesApi.GetKoinotitaById(KoinotitaId)).Name;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load skines: {ex.Message}";
        }
    }
}
