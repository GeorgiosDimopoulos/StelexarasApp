@page "/koinotites/{KoinotitaId:int}"

@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi
@using StelexarasApp.Library.Dtos.People.Staff
@using StelexarasApp.Library.Models.Atoma.Staff
@using StelexarasApp.Library.QueryParameters.Domi
@using StelexarasApp.Library.QueryParameters.People

@inject IXwroiApi XwroiApi
@inject IStelexiApi StelexiApi
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Stelexaras - @Koinotita?.Name</PageTitle>

<h1 style="text-align:center; padding-block-start:30px;">@Koinotita?.Name?.ToUpper() - Παιδιά: @Skines.Sum(sk => sk.PaidiaNumber)</h1>
<h2>
    Στέλεχος:
    @if (Koinotita != null && Koinotita.Name.Contains("Σχολή"))
    {
        @foreach (var ekp in ekpaideutes)
        {
            <MudChip T="StelexosResponse" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => OpenStelexos(ekp))">
                @ekp.FirstName @ekp.LastName
            </MudChip>
        }
    }
    else
    {
        <MudChip T="StelexosResponse" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => OpenStelexos(koinotarxis))">
            @Koinotita?.KoinotarxisName
        </MudChip>
    }
</h2>

<MudGrid Justify="Justify.Center" Style="height:calc(100vh - 10vh);  align-items:center;">
    <MudItem xs="12" sm="4">
        <MudStack AlignItems="AlignItems.Center"
                  Spacing="10">
            @if (Skines.Count > 6)
            {
                @foreach (var sk in Skines.OrderBy(s => s.Name))
                {
                    <MudButton Href="@($"/skines/{sk.Id}")" Style="height:50px; width:450px; border-radius:15px; overflow:hidden; color:white; background-color:#58B98D">
                        @sk.Name - @sk.PaidiaNumber
                    </MudButton>
                }
            }
            else
            {
                @foreach (var sk in Skines.OrderBy(s => s.Name))
                {
                    <MudButton Href="@($"/skines/{sk.Id}")" Style="height:80px; width:500px; border-radius:15px; overflow:hidden; color:white; background-color:#58B98D">
                        @sk.Name - @sk.PaidiaNumber
                    </MudButton>
                }
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public int KoinotitaId { get; set; }

    private string? errorMessage;
    public KoinotitaResponse Koinotita { get; set; } = default!;

    private StelexosResponse koinotarxis { get; set; } = new StelexosResponse();
    private IEnumerable<StelexosResponse> ekpaideutes { get; set; } = new List<StelexosResponse>();
    private List<SkiniResponse> Skines { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Koinotita = await XwroiApi.GetKoinotitaById(KoinotitaId, new KoinotitaQueryParameters() { IncludeStelexos = true });
            Skines = await XwroiApi.GetSkinesByKoinotitaId(KoinotitaId, new SkiniQueryParameters() { IncludePaidia = true, IncludeStelexos = true });

            if (Koinotita.Name.Contains("Σχολή"))
            {
                ekpaideutes = await StelexiApi.GetStelexi(Thesi.Ekpaideutis, new StelexosQueryParameters());
                Koinotita.KoinotarxisName = ekpaideutes.Count() > 0
                    ? string.Join(", ", ekpaideutes.Select(e => $"{e.FirstName} {e.LastName}"))
                    : "Δεν υπάρχουν εκπαιδευτές";
            }
            else if (Koinotita.KoinotarxisId > 0)
            {
                koinotarxis = await StelexiApi.GetStelexosById(Thesi.Koinotarxis, Koinotita.KoinotarxisId, new() { IncludeXwros = true });
                Koinotita.KoinotarxisName = koinotarxis is not null
                    ? $"{koinotarxis.FirstName} {koinotarxis.LastName}"
                    : "Δεν υπάρχει στέλεχος";
            }
            else
            {
                Koinotita.KoinotarxisName = "Δεν υπάρχει στέλεχος";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load kointotia or a field of it: {ex.Message}";
        }
    }

    private async Task OpenStelexos(StelexosResponse stelexos)
    {
        if (stelexos is null || stelexos.Id <= 0)
            return;

        var parameters = new DialogParameters<EditStelexosDialog>
        {
            { x => x.Stelexos, stelexos }
        };

        var dialog = await DialogService.ShowAsync<EditStelexosDialog>("Επεξεργασία Στελέχους", parameters);

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }
}
