@page "/skines/{SkiniId:int}"

@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi
@using StelexarasApp.Library.Dtos.People.Children

@inject ISkinesApi SkinesApi
@inject IPaidiaApi PaidiaApi
@inject IDialogService DialogService

<MudGrid Justify="Justify.Center" Style="height:calc(100vh - 10vh);  align-items:center;">
    <MudText Typo="Typo.h4">ΣΚΗΝΗ: @Skini.Name</MudText>
    <MudItem xs="12" sm="4">
        <MudStack Justify="Justify.Center"
                  AlignItems="AlignItems.Center"
                  Spacing="10">
            @foreach (var p in Paidia)
            {
                <MudButton Href="@($"/skines/{p.Id}")" Style="height:100px; padding:30px;width:500px; border-radius:16px; overflow:hidden; color:white; background-color:yellowgreen">
                    @p.FullName
                </MudButton>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public int SkiniId { get; set; }
    private SkiniResponse Skini = new SkiniResponse();
    private List<PaidiResponse> Paidia = new List<PaidiResponse>();

    protected override async Task OnInitializedAsync()
    {
        Skini = await SkinesApi.GetSkini(Id, new());
        Paidia = await PaidiaApi.GetPaidiaBySkiniId(Id, new());
    }
}