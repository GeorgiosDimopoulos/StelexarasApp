@page "/skines/{SkiniId:int}"

@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi
@using StelexarasApp.Library.Dtos.People.Children
@using StelexarasApp.Library.Dtos.People.Staff
@using StelexarasApp.Library.Models.Atoma

@inject IXwroiApi XwroiApi
@inject IPaidiaApi PaidiaApi
@inject IStelexiApi StelexiApi
@inject IDialogService DialogService

@inject NavigationManager NavigationManager

<h1 style="text-align:center;">@Skini.Name (@SexOfSKini(@Skini.Sex)): @Paidia.Count δύναμη</h1>
<h2 style="padding-block-start:10px;">
    Στέλεχος:
    <MudChip T="StelexosResponse" Color="Color.Primary" Variant="Variant.Outlined" OnClick="@(() => OpenStelexos())">
        @Skini?.OmadarxisName
    </MudChip>
</h2>
<div style="padding:0px 30px;">
    <MudTable Items="Paidia">
        <HeaderContent>
            <MudTh Style="font-weight:bold;">Όνομα</MudTh>
            <MudTh Style="font-weight:bold;">Ηλικία</MudTh>
            <MudTh Style="font-weight:bold;">Τηλ Γονέα</MudTh>
            <MudTh Style="font-weight:bold;">Σε άδεια;</MudTh>
            <MudTh Style="font-weight:bold;">Επεξεργασία</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.LastName @context.FirstName</MudTd>
            <MudTd>@context.Age</MudTd>
            <MudTd>@context.ParentTel</MudTd>            
            <MudTd>@IsPresent(context.SeAdeia)</MudTd>
            <MudTd>
                <MudButton Color="Color.Success"
                           Variant="Variant.Filled"
                           Style="min-width:40px; width:40px; height:30px; padding:0;"
                           OnClick="@(() => OpenPaidi(context))">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" />
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</div>
@code {
    [Parameter]
    public int SkiniId { get; set; }

    private SkiniResponse Skini = new SkiniResponse();
    private List<PaidiResponse> Paidia = new List<PaidiResponse>();

    protected override async Task OnInitializedAsync()
    {
        Skini = await XwroiApi.GetSkiniById(SkiniId, new() { IncludeStelexos = true});
        if (Skini is null)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        Paidia = (await PaidiaApi.GetPaidiaBySkiniId(SkiniId, new(){IncludeSkini = true})).OrderBy(c => c.LastName).ToList();
    }

    private async Task OpenPaidi(PaidiResponse context)
    {
        var parameters = new DialogParameters<EditPaidiDialog>
        {                 
            { x => x.Paidi, context }
        };

        var dialog = await DialogService.ShowAsync<EditPaidiDialog>("Επεξεργασία Παιδιού", parameters);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task OpenStelexos()
    {
        if (Skini.OmadarxisId < 0)
            return;

        var omadarxis = await StelexiApi.GetStelexosById(Skini.OmadarxisId, new());
        if (omadarxis is null)
            return;

        var parameters = new DialogParameters<EditStelexosDialog>
        {
            { x => x.Stelexos, omadarxis }
        };

        var dialog = await DialogService.ShowAsync<EditStelexosDialog>("Επεξεργασία Στελέχους", parameters);

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private string SexOfSKini(Sex sex)
    {
        return sex switch
        {
            Sex.Male => "Αγόρια",
            Sex.Female => "Κορίτσια",
            _ => "Άγνωστο φύλο"
        };
    }

    private string IsPresent(bool seAdeia)
    {
        return seAdeia ? "Σε Αδεία" : "Εδώ";
    }
}