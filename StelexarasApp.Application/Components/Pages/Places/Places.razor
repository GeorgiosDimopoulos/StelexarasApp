@page "/places"
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi
@using StelexarasApp.Library.Models.Domi
@using StelexarasApp.Library.QueryParameters.Domi

@inject IXwroiApi XwroiApi
@inject IPaidiaApi PaidiaApi
@inject IDialogService DialogService

<PageTitle>Stelexaras - ΚΟΙΝΟΤΗΤΕΣ</PageTitle>

<div style="background: linear-gradient(rgba(255,255,255,0.68),rgba(225,245,242,0.68)), url('/images/football.jpg') center/cover no-repeat;">
    <h1 style="text-align:center; margin-bottom:10px; color:dimgray">ΠΑΙΔΙΑ: @allPaidia</h1>
    <h3 style="text-align:center; margin-bottom:10px; color:dimgray">ΔΥΝΑΜΗ: @dunamhPaidia</h3>
    <h3 style="text-align:center; margin-bottom:10px; color:dimgray">ΣΕ ΑΔΕΙΑ: @seAdeiaPaidia</h3>

    <MudGrid Justify="Justify.Center" Style="height:calc(100vh - 15vh);">
        @foreach (var tomeas in Tomeis)
        {
            <MudItem xs="12" sm="4">
                <h2 style="text-align:center;margin-bottom:20px;">"ΤΟΜΕΑΣ" @tomeas.Name</h2>
                <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="5">
                    @foreach (var koinotita in Koinotites.Where(k => k.TomeasName.Contains(tomeas.Name)).OrderBy(k => k.Name))
                    {
                        @if (koinotita.Hlikia == HlikiaKoinotitas.Sxoli)
                        {
                            <MudButton Href="@($"/koinotites/{koinotita.Id}")" Style="height:70px; padding:30px;width:500px; border-radius:16px; overflow:hidden; color:#1f3b4d; background-color:lightblue">
                                @koinotita.Name - @KoinotitaPaidia[koinotita.Id]
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Href="@($"/koinotites/{koinotita.Id}")" Style="height:70px; padding:30px;width:500px; border-radius:16px; overflow:hidden; color:white; background-color:#58B98D">
                                @koinotita.Name - @KoinotitaPaidia[koinotita.Id]
                            </MudButton>
                        }
                    }
                </MudStack>
            </MudItem>
        }
    </MudGrid>
</div>
@code
{
    private List<TomeasResponse> Tomeis = new List<TomeasResponse>();
    private List<KoinotitaResponse> Koinotites = new List<KoinotitaResponse>();
    private Dictionary<int, int> KoinotitaPaidia = new();
    private int allPaidia;
    private int seAdeiaPaidia;
    private int dunamhPaidia;

    protected override async Task OnInitializedAsync()
    {
        Tomeis = await XwroiApi.GetTomeisAsync(new TomeasQueryParameters() { IncludeStelexos = true });
        Koinotites = await XwroiApi.GetKoinotitesAsync(new KoinotitaQueryParameters() { IncludeStelexos = true });
        seAdeiaPaidia = 0;

        foreach (var koinotita in Koinotites)
        {
            var paidiaKoinotitas = await PaidiaApi.GetPaidiaByKoinotitaId(koinotita.Id, new());
            KoinotitaPaidia[koinotita.Id] = paidiaKoinotitas.Count;
            seAdeiaPaidia += paidiaKoinotitas.Count(p => p.SeAdeia);
        }

        allPaidia = KoinotitaPaidia.Values.Sum();
        dunamhPaidia = allPaidia - seAdeiaPaidia;
    }
}