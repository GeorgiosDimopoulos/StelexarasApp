@page "/xwroi"
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.Domi
@using StelexarasApp.Library.QueryParameters.Domi

@inject IKoinotitesApi KoinotitesApi
@inject IDialogService DialogService

<h1 style="text-align:center; padding-block-start:5px; margin-bottom:4px">ΚΟΙΝΟΤΗΤΕΣ</h1>
<MudGrid Justify="Justify.Center" Style="height:calc(100vh - 10vh);  align-items:center;">
    <MudItem xs="12" sm="4">
        <h1 style="text-align:center">Α ΤΟΜΕΑΣ</h1>
        <MudStack Justify="Justify.Center"
                  AlignItems="AlignItems.Center"
                  Spacing="5">
            @foreach (var koinotita in Koinotites.Where(k => k.TomeasName.Equals("A")).OrderBy(k => k.Name))
            {
                <MudButton Href="@($"/koinotites/{koinotita.Id}")" Style="height:100px; padding:30px;width:500px; border-radius:16px; overflow:hidden; color:white; background-color:yellowgreen">
                    @koinotita.Name
                </MudButton>
            }
        </MudStack>
    </MudItem>
    <MudItem xs="12" sm="4">
        <h1 style="text-align:center">B ΤΟΜΕΑΣ</h1>
        <MudStack Justify="Justify.Center"
                  AlignItems="AlignItems.Center"
                  Spacing="5">
            @foreach (var koinotita in Koinotites.Where(k => k.TomeasName.Equals("B")).OrderBy(k => k.Name))
            {
                var backgroundColor = koinotita.Name.ToUpper().Contains("ΣΧΟΛΉ") ? "dodgerblue" : "yellowgreen";
                <MudButton Href="@($"/koinotites/{koinotita.Id}")" Style="@($"height:100px; padding:30px; width:500px; border-radius:16px; overflow:hidden; color:white; background-color:{backgroundColor};")">
                    @koinotita.Name
                </MudButton>
            }
        </MudStack>
    </MudItem>
    @*<MudItem xs="12" sm="4">
        <MudStack Justify="Justify.Center"
                  AlignItems="AlignItems.Center"
                  Spacing="10">
            <MudButton Href="/sxoli"
                       Style="height:100%; width:500px; border-radius:16px; overflow:hidden; color:white; background-color:yellowgreen">
                ΣΧΟΛΗ
            </MudButton>
            <MudButton Href="/sxoli"
                       Style="height:100%; width:500px; border-radius:16px; overflow:hidden; color:white; background-color:yellowgreen">
                ΕΙΔΙΚΑ
            </MudButton>
            <MudButton Href="/sxoli"
                       Style="height:100%; width:500px; border-radius:16px; overflow:hidden; color:white; background-color:yellowgreen">
                ΑΡΧΗΓΕΙΟ
            </MudButton>
        </MudStack>
    </MudItem>*@
</MudGrid>

@code
{
    private List<KoinotitaResponse> Koinotites = new List<KoinotitaResponse>();

    protected override async Task OnInitializedAsync()
    {
        Koinotites = await KoinotitesApi.GetKoinotitesAsync(new KoinotitaQueryParameters() { IncludeStelexos = true });
    }
}