@page "/"

@layout EmptyLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Refit
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Application.Services

@inject NavigationManager Navigation
@inject TokenService TokenService
@inject IAuthClient AuthClient

@attribute [AllowAnonymous]

<PageTitle>Stelexaras - Login</PageTitle>

<div style="min-height:100vh;
    background: linear-gradient(rgba(0,0,0,0.20), rgba(0,0,0,0.20)), url('/images/pool.jpg') center center / cover no-repeat;
                        background-color: #f7f2f4;
                        display:flex; justify-content:center;
                        align-items:center;">
    <MudPaper Elevation="6" Class="p-4" Style="width: 300px; margin: auto; margin-top: 300px; text-align:center;">
        <MudText style="color:white">ΤΥΠΕΤ ΣΤΕΛΕΧΑΡΑΣ</MudText>
        <MudTextField @bind-Value="password"
                      Label="Password"
                      style="background-color:white"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      InputType="@PasswordInput"
                      Adornment="Adornment.End"
                      OnKeyUp="HandleKeyUp"
                      AdornmentIcon="@PasswordInputIcon"
                      AdornmentColor="Color.Default"
                      OnAdornmentClick="TogglePasswordVisibility"
                      AdornmentAriaLabel="Show Password" />
        <MudButton style="color:white; background-color:orange" Variant="Variant.Filled" Color="Color.Primary" OnClick="Login"> Είσοδος </MudButton>
        @if (showErrors)
        {
            <MudAlert style="color:white" Severity="Severity.Error" Variant="Variant.Filled" Elevation="6" Class="mt-2"> @error </MudAlert>
        }
    </MudPaper>
</div>

@code {
    private string password = string.Empty;
    private string error = string.Empty; 
    private bool showErrors;
    private string PasswordInputIcon = Icons.Material.Filled.Visibility;
    private InputType PasswordInput = InputType.Password;

    private async Task Login()
    {
        if (string.IsNullOrEmpty(password))
        {
            showErrors = true;
            error = "Πληκτρολογήθηκε κενός κωδικός!";
            return;
        }

        try
        {
            var result = await AuthClient.AuthenticateAsync(new LoginRequest { Password = password });
            if (result != null && !string.IsNullOrEmpty(result.Token))
            {
                showErrors = false;
                error = string.Empty;

                TokenService.SaveToken(result.Token);
                Navigation.NavigateTo("/home");
            }
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            showErrors = true;
            error = "ΛΑΘΟΣ ΚΩΔΙΚΟΣ";
        }
        catch (Exception ex)
        {
            showErrors = true;
            error = "ΛΑΘΟΣ ΚΩΔΙΚΟΣ, " + ex.Message;
        }
    }

    private void TogglePasswordVisibility()
    {
        if (PasswordInput == InputType.Password)
        {
            PasswordInput = InputType.Text;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
        }
        else
        {
            PasswordInput = InputType.Password;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Login();
    }
}