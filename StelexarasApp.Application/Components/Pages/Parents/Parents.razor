@page "/parents"
@using StelexarasApp.Application.ApiClients
@using StelexarasApp.Library.Dtos.People
@using StelexarasApp.Library.Dtos.People.Children
@using StelexarasApp.Library.QueryParameters.People

@inject IPaidiaApi PaidiaApi
@inject IParentsApi ParentsApi
@inject NavigationManager Navigation
@inject IDialogService DialogService

<h2 style="text-align:center; margin-bottom:10px; color:dimgray">ΓΟΝΕΊΣ: @allParents</h2>

<div style="background: linear-gradient(rgba(255,255,255,0.68),rgba(225,245,242,0.68)), url('/images/football.jpg') center/cover no-repeat;">
    <MudTable Items="_parents">
        <HeaderContent>
            <MudTh Style="font-weight:bold;">Όνομα</MudTh>
            <MudTh Style="font-weight:bold;">Email</MudTh>
            <MudTh Style="font-weight:bold;">Τηλέφωνο</MudTh>
            <MudTh Style="font-weight:bold;">ΑΦΜ</MudTh>
            <MudTh Style="font-weight:bold;">Παιδιά</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.LastName @context.LastName + @context.FirstName</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>@context.Phone</MudTd>
            <MudTd>@context.AFM</MudTd>
            <MudTd>
                @if (context.Paidia.Count() > 0)
                {
                    @foreach (var paidi in context.Paidia)
                    {
                        <MudSelectItem T="PaidiResponse" Value="paidi">
                            @paidi.FirstName @paidi.LastName
                        </MudSelectItem>
                    }
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</div>

@code {
    private int allParents = 0;

    private IEnumerable<ParentResponse> _parents = new List<ParentResponse>();
    private IEnumerable<PaidiResponse> _kids = new List<PaidiResponse>();

    protected override async Task OnInitializedAsync()
    {
        _parents = await ParentsApi.GetParentsAsync(new ParentQueryParameters());
        allParents = _parents.Count();
    }
}
